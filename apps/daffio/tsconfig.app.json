{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "../../dist/out-tsc/apps/daffio",
		"skipLibCheck": true,
    "composite": true
	},
	"exclude": ["test.ts", "**/*.spec.ts"],
	"include": ["**/*.ts"],
	"angularCompilerOptions": {
		"extendedDiagnostics": {
			"checks": {
				"nullishCoalescingNotNullable": "suppress",
				"optionalChainNotNullable": "suppress"
			}
		},
		"strictTemplates": false
	}
}

{
  "name": "@daffodil/cart",
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{workspaceRoot}/dist/cart"
        ]
      }
    }
  },
  "version": "0.0.0-PLACEHOLDER",
  "description": "Platform-agnostic models, state management, and drivers for retrieving and interacting with ecommerce carts. Part of the Daffodil ecommerce framework.",
  "repository": {
    "type": "git",
    "url": "https://github.com/graycoreio/daffodil"
  },
  "author": "Graycore LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/graycoreio/daffodil/issues"
  },
  "scripts": {
    "build": "ng build cart --configuration production",
    "lint": "cd ../.. && ng lint cart",
    "lint:fix": "npm run lint -- --fix",
    "test": "ng test cart --watch=false --browsers=ChromeHeadless",
    "prepublish": "",
    "publish": "cd ../../dist/cart && npm publish --access=public"
  },
  "homepage": "https://github.com/graycoreio/daffodil",
  "peerDependencies": {
    "@angular/common": "0.0.0-PLACEHOLDER",
    "@angular/core": "0.0.0-PLACEHOLDER",
    "@daffodil/core": "0.0.0-PLACEHOLDER",
    "@daffodil/product": "0.0.0-PLACEHOLDER",
    "@daffodil/geography": "0.0.0-PLACEHOLDER",
    "@daffodil/payment": "0.0.0-PLACEHOLDER",
    "@ngrx/effects": "0.0.0-PLACEHOLDER",
    "@ngrx/entity": "0.0.0-PLACEHOLDER",
    "@ngrx/store": "0.0.0-PLACEHOLDER",
    "rxjs": "0.0.0-PLACEHOLDER",
    "@daffodil/driver": "0.0.0-PLACEHOLDER"
  },
  "optionalDependencies": {
    "@faker-js/faker": "0.0.0-PLACEHOLDER",
    "angular-in-memory-web-api": "0.0.0-PLACEHOLDER",
    "apollo-angular": "0.0.0-PLACEHOLDER",
    "@apollo/client": "0.0.0-PLACEHOLDER",
    "@daffodil/driver": "0.0.0-PLACEHOLDER"
  },
  "devDependencies": {
    "@daffodil/core": "0.0.0-PLACEHOLDER",
    "@daffodil/payment": "0.0.0-PLACEHOLDER",
    "@daffodil/product": "0.0.0-PLACEHOLDER",
    "@daffodil/geography": "0.0.0-PLACEHOLDER",
    "@daffodil/driver": "0.0.0-PLACEHOLDER"
  },
  "exports": {
    "./driver/magento/auto": {
      "cart-magento-2.4.7": {
        "types": "./types/daffodil-cart-driver-magento-2.4.7.d.ts",
        "default": "./fesm2022/daffodil-cart-driver-magento-2.4.7.mjs"
      },
      "default": {
        "types": "./types/daffodil-cart-driver-magento-2.4.7.d.ts",
        "default": "./fesm2022/daffodil-cart-driver-magento-2.4.7.mjs"
      }
    },
    "./driver/magento/auto/testing": {
      "cart-magento-2.4.7": {
        "types": "./types/daffodil-cart-driver-magento-2.4.7-testing.d.ts",
        "default": "./fesm2022/daffodil-cart-driver-magento-2.4.7-testing.mjs"
      },
      "default": {
        "types": "./types/daffodil-cart-driver-magento-2.4.7-testing.d.ts",
        "default": "./fesm2022/daffodil-cart-driver-magento-2.4.7-testing.mjs"
      }
    }
  }
}

{
  "name": "@daffodil/order",
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{workspaceRoot}/dist/order"
        ]
      }
    }
  },
  "version": "0.0.0-PLACEHOLDER",
  "description": "Platform-agnostic models, state management, and drivers for retrieving and interacting with ecommerce orders. Part of the Daffodil ecommerce framework.",
  "repository": {
    "type": "git",
    "url": "https://github.com/graycoreio/daffodil"
  },
  "author": "Graycore LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/graycoreio/daffodil/issues"
  },
  "scripts": {
    "build": "ng build order --configuration production",
    "lint": "cd ../.. && ng lint order",
    "lint:fix": "npm run lint -- --fix",
    "test": "ng test order --watch=false --browsers=ChromeHeadless",
    "publish": "cd ../../dist/order && npm publish --access=public"
  },
  "homepage": "https://github.com/graycoreio/daffodil",
  "peerDependencies": {
    "@angular/core": "0.0.0-PLACEHOLDER",
    "@angular/common": "0.0.0-PLACEHOLDER",
    "@daffodil/cart": "0.0.0-PLACEHOLDER",
    "@daffodil/core": "0.0.0-PLACEHOLDER",
    "@daffodil/geography": "0.0.0-PLACEHOLDER",
    "@daffodil/product": "0.0.0-PLACEHOLDER"
  },
  "devDependencies": {
    "@daffodil/cart": "0.0.0-PLACEHOLDER",
    "@daffodil/core": "0.0.0-PLACEHOLDER",
    "@daffodil/geography": "0.0.0-PLACEHOLDER",
    "@daffodil/product": "0.0.0-PLACEHOLDER"
  },
	"exports": {
		"./driver/magento/auto": {
			"order-magento-2.4.0": {
				"types": "./driver/magento/2.4.0/index.d.ts",
				"default": "./fesm2022/daffodil-order-driver-magento-2.4.0.mjs"
			},
			"order-magento-2.4.1": {
				"types": "./driver/magento/2.4.1/index.d.ts",
				"default": "./fesm2022/daffodil-order-driver-magento-2.4.1.mjs"
			},
			"default": {
				"types": "./driver/magento/2.4.1/index.d.ts",
				"default": "./fesm2022/daffodil-order-driver-magento-2.4.1.mjs"
			}
		},
		"./driver/magento/auto/testing": {
			"order-magento-2.4.0": {
				"types": "./driver/magento/2.4.0/testing/index.d.ts",
				"default": "./fesm2022/daffodil-order-driver-magento-2.4.0-testing.mjs"
			},
			"order-magento-2.4.1": {
				"types": "./driver/magento/2.4.1/testing/index.d.ts",
				"default": "./fesm2022/daffodil-order-driver-magento-2.4.1-testing.mjs"
			},
			"default": {
				"types": "./driver/magento/2.4.1/testing/index.d.ts",
				"default": "./fesm2022/daffodil-order-driver-magento-2.4.1-testing.mjs"
			}
		}
	}
}

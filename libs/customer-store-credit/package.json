{
  "name": "@daffodil/customer-store-credit",
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{workspaceRoot}/dist/customer-store-credit"
        ]
      }
    }
  },
  "version": "0.0.0-PLACEHOLDER",
  "description": "Platform-agnostic models, state management, and drivers for customer store credit balances. Part of the Daffodil ecommerce framework.",
  "repository": {
    "type": "git",
    "url": "https://github.com/graycoreio/daffodil"
  },
  "author": "Graycore LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/graycoreio/daffodil/issues"
  },
  "scripts": {
    "build": "ng build customer-store-credit --configuration production",
    "lint": "cd ../.. && ng lint customer-store-credit",
    "lint:fix": "npm run lint -- --fix",
    "test": "ng test customer-store-credit --watch=false --browsers=ChromeHeadless",
    "publish": "cd ../../dist/customer-store-credit && npm publish --access=public"
  },
  "homepage": "https://github.com/graycoreio/daffodil",
  "peerDependencies": {
    "@angular/common": "0.0.0-PLACEHOLDER",
    "@angular/core": "0.0.0-PLACEHOLDER",
    "@daffodil/customer": "0.0.0-PLACEHOLDER",
    "@daffodil/customer-order": "0.0.0-PLACEHOLDER",
    "@daffodil/core": "0.0.0-PLACEHOLDER",
    "@ngrx/effects": "0.0.0-PLACEHOLDER",
    "@ngrx/store": "0.0.0-PLACEHOLDER",
    "rxjs": "0.0.0-PLACEHOLDER"
  },
  "optionalDependencies": {
    "@apollo/client": "0.0.0-PLACEHOLDER",
    "@daffodil/driver": "0.0.0-PLACEHOLDER",
    "apollo-angular": "0.0.0-PLACEHOLDER",
    "@faker-js/faker": "0.0.0-PLACEHOLDER"
  },
  "devDependencies": {
    "@daffodil/core": "0.0.0-PLACEHOLDER",
    "@daffodil/customer-order": "0.0.0-PLACEHOLDER",
    "@daffodil/customer": "0.0.0-PLACEHOLDER",
    "@daffodil/driver": "0.0.0-PLACEHOLDER"
  }
}

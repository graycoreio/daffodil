{
  "extends": "../../tsconfig.json",
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ],
  "compilerOptions": {
    "paths": {
      "@daffodil/*": [
        "../../dist/*"
      ],
      "@daffodil/core": [
        "./src"
      ],
      "@daffodil/core/testing": [
        "./testing/src"
      ],
      "@daffodil/core/graphql": [
        "./graphql/src"
      ],
      "@daffodil/core/state": [
        "./state/src"
      ],
      "@daffodil/core/state/testing": [
        "./state/testing/src"
      ],
      "@daffodil/core/routing": [
        "./routing/src"
      ],
      "@daffodil/core/external-script": [
        "./external-script/src"
      ],
      "@daffodil/core/external-script/testing": [
        "./external-script/testing/src"
      ]
    }
  }
}

{
  "name": "@daffodil/driver",
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{workspaceRoot}/dist/driver"
        ]
      }
    }
  },
  "version": "0.0.0-PLACEHOLDER",
  "description": "Base driver interfaces and utilities for connecting Daffodil to ecommerce platforms. Part of the Daffodil ecommerce framework.",
  "repository": {
    "type": "git",
    "url": "https://github.com/graycoreio/daffodil"
  },
  "author": "Graycore LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/graycoreio/daffodil/issues"
  },
  "scripts": {
    "build": "ng build driver --configuration production",
    "test": "ng test driver --watch=false --browsers=ChromeHeadless",
    "lint": "cd ../.. && ng lint driver",
    "lint:fix": "npm run lint -- --fix",
    "publish": "cd ../../dist/driver && npm publish --access=public",
    "generateFragmentTypes": "ng run driver:generateFragmentTypes",
    "shopify:codegen:generate": "graphql-codegen -c shopify-codegen.config.ts"
  },
  "homepage": "https://github.com/graycoreio/daffodil",
  "optionalDependencies": {
    "angular-in-memory-web-api": "0.0.0-PLACEHOLDER"
  },
  "peerDependencies": {
    "@angular/common": "0.0.0-PLACEHOLDER",
    "@angular/core": "0.0.0-PLACEHOLDER",
    "rxjs": "0.0.0-PLACEHOLDER"
  },
  "devDependencies": {
    "@daffodil/core": "0.0.0-PLACEHOLDER"
  },
  "exports": {
    "./magento/auto": {
      "driver-magento-2.4.7": {
        "types": "./types/daffodil-driver-magento-2.4.7.d.ts",
        "default": "./fesm2022/daffodil-driver-magento-2.4.7.mjs"
      },
      "default": {
        "types": "./types/daffodil-driver-magento-2.4.7.d.ts",
        "default": "./fesm2022/daffodil-driver-magento-2.4.7.mjs"
      }
    },
    "./magento/auto/testing": {
      "driver-magento-2.4.7": {
        "types": "./types/daffodil-driver-magento-2.4.7-testing.d.ts",
        "default": "./fesm2022/daffodil-driver-magento-2.4.7-testing.mjs"
      },
      "default": {
        "types": "./types/daffodil-driver-magento-2.4.7-testing.d.ts",
        "default": "./fesm2022/daffodil-driver-magento-2.4.7-testing.mjs"
      }
    }
  }
}

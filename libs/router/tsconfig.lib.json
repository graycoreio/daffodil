{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "../../dist/out-tsc/libs/router",
		"declaration": true,
		"declarationMap": true,
		"inlineSources": true,
		"types": [],
    "composite": true
	},
	"exclude": ["**/*.spec.ts", "**/*.test.ts"],
	"include": ["**/*.ts"],
	"angularCompilerOptions": {
		"extendedDiagnostics": {
			"checks": {
				"nullishCoalescingNotNullable": "suppress",
				"optionalChainNotNullable": "suppress"
			}
		}
	}
}

{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "../../dist/out-tsc/libs/cart-store-credit",
		"types": ["jasmine", "node"],
    "composite": true
	},
	"files": ["./test.ts"],
	"include": ["**/*.spec.ts", "**/*.d.ts", "**/*.ts"],
	"angularCompilerOptions": {
		"extendedDiagnostics": {
			"checks": {
				"nullishCoalescingNotNullable": "suppress",
				"optionalChainNotNullable": "suppress"
			}
		},
		"strictTemplates": false
	}
}

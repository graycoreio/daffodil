{
  "name": "@daffodil/storefront",
  "version": "0.0.0-PLACEHOLDER",
  "author": "Graycore LLC",
  "license": "MIT",
  "homepage": "https://github.com/graycoreio/daffodil",
  "description": "High-level ecommerce UI components built on @daffodil/design for storefront applications. Part of the Daffodil ecommerce framework.",
  "bugs": {
    "url": "https://github.com/graycoreio/daffodil/issues"
  },
	"repository": {
    "type": "git",
    "url": "https://github.com/graycoreio/daffodil"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{workspaceRoot}/dist/storefront"
        ]
      }
    }
  },
  "scripts": {
    "build": "ng build storefront --configuration production",
    "lint": "npm run lint:scss && cd ../.. && ng lint storefront",
    "lint:scss": "stylelint '**/*.scss' '!**/examples/**'",
    "lint:scss:fix": "npm run lint:scss -- --fix",
    "lint:fix": "npm run lint -- --fix",
    "test": "npm run test:angular",
    "test:scss": "jasmine scss/test_scss.js",
    "test:angular": "ng test storefront --watch=false --browsers=ChromeHeadless",
    "publish": "cd ../../dist/storefront && npm publish --access=public"
  },
  "peerDependencies": {
    "@angular/common": "0.0.0-PLACEHOLDER",
    "@angular/core": "0.0.0-PLACEHOLDER",
    "@daffodil/design": "0.0.0-PLACEHOLDER"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "devDependencies": {
    "@daffodil/design": "0.0.0-PLACEHOLDER"
  },
  "exports": {
    "./scss/theme": {
      "sass": "./scss/theme.scss"
    }
  }
}

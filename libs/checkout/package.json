{
  "name": "@daffodil/checkout",
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{workspaceRoot}/dist/checkout"
        ]
      }
    }
  },
  "version": "0.0.0-PLACEHOLDER",
  "description": "State management and routing for ecommerce checkout flows. Part of the Daffodil ecommerce framework.",
  "repository": {
    "type": "git",
    "url": "https://github.com/graycoreio/daffodil"
  },
  "author": "Graycore LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/graycoreio/daffodil/issues"
  },
  "scripts": {
    "build": "ng build checkout --configuration production",
    "lint": "cd ../.. && ng lint checkout",
    "lint:fix": "npm run lint -- --fix",
    "test": "ng test checkout --watch=false --browsers=ChromeHeadless",
    "publish": "cd ../../dist/checkout && npm publish --access=public"
  },
  "homepage": "https://github.com/graycoreio/daffodil",
  "peerDependencies": {
    "@angular/common": "0.0.0-PLACEHOLDER",
    "@angular/core": "0.0.0-PLACEHOLDER",
    "@daffodil/cart": "0.0.0-PLACEHOLDER",
    "@daffodil/core": "0.0.0-PLACEHOLDER",
    "@daffodil/order": "0.0.0-PLACEHOLDER",
    "@daffodil/product": "0.0.0-PLACEHOLDER",
    "@ngrx/effects": "0.0.0-PLACEHOLDER",
    "@ngrx/entity": "0.0.0-PLACEHOLDER",
    "@ngrx/store": "0.0.0-PLACEHOLDER",
    "rxjs": "0.0.0-PLACEHOLDER"
  },
  "optionalDependencies": {
    "@faker-js/faker": "0.0.0-PLACEHOLDER",
    "angular-in-memory-web-api": "0.0.0-PLACEHOLDER"
  },
  "devDependencies": {
    "@daffodil/cart": "0.0.0-PLACEHOLDER",
    "@daffodil/core": "0.0.0-PLACEHOLDER",
    "@daffodil/order": "0.0.0-PLACEHOLDER",
    "@daffodil/product": "0.0.0-PLACEHOLDER"
  },
	"exports": {
		"./driver/magento/auto": {
			"checkout-magento-2.4.7": {
				"types": "./driver/magento/2.4.7/index.d.ts",
				"default": "./fesm2022/daffodil-checkout-driver-magento-2.4.7.mjs"
			},
			"default": {
				"types": "./driver/magento/2.4.7/index.d.ts",
				"default": "./fesm2022/daffodil-checkout-driver-magento-2.4.7.mjs"
			}
		},
		"./driver/magento/auto/testing": {
			"checkout-magento-2.4.7": {
				"types": "./driver/magento/2.4.7/testing/index.d.ts",
				"default": "./fesm2022/daffodil-checkout-driver-magento-2.4.7-testing.mjs"
			},
			"default": {
				"types": "./driver/magento/2.4.7/testing/index.d.ts",
				"default": "./fesm2022/daffodil-checkout-driver-magento-2.4.7-testing.mjs"
			}
		}
	}
}

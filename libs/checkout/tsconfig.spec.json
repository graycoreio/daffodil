{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "../../dist/out-tsc/libs/checkout",
		"types": ["jasmine", "node"],
		"composite": true
	},
	"include": ["**/*.spec.ts", "**/*.d.ts", "**/*.ts"],
	"angularCompilerOptions": {
		"extendedDiagnostics": {
			"checks": {
				"nullishCoalescingNotNullable": "suppress",
				"optionalChainNotNullable": "suppress"
			}
		},
		"strictTemplates": false
	}
}

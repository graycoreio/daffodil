{
  "$schema": "http://json-schema.org/schema",
  "$id": "DaffodilNgAdd",
  "title": "Daffodil ng-add Options Schema",
  "type": "object",
  "description": "Adds Daffodil commerce demo to an existing Angular project",
  "properties": {
    "project": {
      "type": "string",
      "description": "The name of the project to add Daffodil to",
      "$default": {
        "$source": "projectName"
      }
    },
    "skipPackageJson": {
      "type": "boolean",
      "description": "Skip updating package.json dependencies",
      "default": false
    },
    "isNewProject": {
      "type": "boolean",
      "description": "Is this a new Angular project?",
      "x-prompt": "Is this a new Angular project?"
    },
    "driver": {
      "type": "string",
      "description": "Which driver do you want to use?",
      "enum": [
        "magento",
        "shopify",
        "in-memory",
        "demo"
      ],
      "x-prompt": {
        "message": "Which driver do you want to use?",
        "type": "list",
        "items": [
          {
            "value": "magento",
            "label": "Magento"
          },
          {
            "value": "shopify",
            "label": "Shopify"
          },
          {
            "value": "in-memory",
            "label": "In-Memory (for testing)"
          },
          {
            "value": "demo",
            "label": "Demo (Swapping between drivers)"
          }
        ]
      }
    }
  },
	"if": {
		"properties": {
			"driver": {
				"const": "magento"
			}
		}
	},
	"then": {
		"properties": {
			"driverVersion": {
				"pattern": "[0-9]\\.[0-9]\\.[0-9](-p[0-9])?",
				"type": "string",
      	"description": "The version of magento to target."
			}
		}
	},
	"else": {
		"if": {
			"properties": {
				"driver": {
					"const": "shopify"
				}
			}
		},
		"then": {
			"properties": {
				"driverVersion": {
					"pattern": "[0-9]\\.[0-9]\\.[0-9]",
					"type": "string",
					"description": "The version of shopify to target."
				}
			}
		}
	}
}
{
  "extends": "../tsconfig.tools.json",
  "references": [
    {
      "path": "./tsconfig.spec.json"
    }
  ],
  "compilerOptions": {
    "outDir": "../../dist/commerce",
    "rootDir": ".",
    "module": "node20",
    "moduleResolution": "node16",
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "declaration": true
  },
  "exclude": [
    "**/*.spec.ts",
    "**/files/**/*.ts",
    "node_modules"
  ]
}

{
	"$schema": "https://raw.githubusercontent.com/nrwl/nx/master/packages/nx/schemas/nx-schema.json",
	"affected": {
		"defaultBase": "develop"
	},
	"extends": "nx/presets/npm.json",
	"namedInputs": {
		"default": ["{projectRoot}/**/*"],
		"notSpec": ["!{projectRoot}/**/*.spec.{ts,tsx}"],
		"notIndex": ["!{projectRoot}/**/index.json"],
		"sharedGlobals": [
			"{workspaceRoot}/angular.json",
			"{workspaceRoot}/tsconfig.json",
			"{workspaceRoot}/lerna.json",
			"{workspaceRoot}/package-lock.json",
			{ "runtime": "node --version" }
		],
		"eslint": [
			"{workspaceRoot}/.eslintrc.js",
			"{workspaceRoot}/tools/eslint/config/index.js",
			"{workspaceRoot}/.stylelintrc"
		],
		"docs": [
			"{workspaceRoot}/**/*.md",
			"{workspaceRoot}/**/index.json",
			"{workspaceRoot}/libs/**/*.ts",
			"{workspaceRoot}/libs/**/*.html",
			"{workspaceRoot}/libs/**/*.scss"
		]
	},
	"targetDependencies": {
		"build": [
			{
				"target": "build",
				"projects": "dependencies"
			}
		]
	},
	"targetDefaults": {
		"build": {
			"cache": true,
			"inputs": [
				"default",
				"^default",
				"notSpec",
				"^notSpec",
				"notIndex",
				"^notIndex",
				"sharedGlobals"
			],
			"dependsOn": ["^build"]
		},
		"test": {
			"cache": true,
			"inputs": [
				"default",
				"sharedGlobals",
				{ "dependentTasksOutputFiles": "**/*", "transitive": true }
			],
			"dependsOn": ["build"]
		},
		"lint": {
			"cache": true,
			"inputs": ["default", "eslint"],
			"dependsOn": [
				{
					"projects": ["@daffodil/eslint-config"],
					"target": "build"
				}
			]
		},
		"generateFragmentTypes": {
			"dependsOn": [
				{
					"projects": ["@daffodil/builders"],
					"target": "build"
				}
			]
		}
	},
	"analytics": false
}

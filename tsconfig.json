{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "ES2022",
      "dom",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "@daffodil/analytics/driver/data-layer": [
        "libs/analytics/driver/data-layer"
      ],
      "@daffodil/analytics": [
        "libs/analytics/src"
      ],
      "@daffodil/*": [
        "dist/*"
      ]
    },
    "useDefineForClassFields": false
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
